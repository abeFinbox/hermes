    "code": "test('status is 200', () => { expect(response.status).toBe(200); });"
  },
  {
    "name": "toEqual object pass and fail",
    "mode": "validate",
    "response": { "status": 200, "statusText": "OK", "headers": {}, "time": 10, "bodyText": "{\"a\":1,\"b\":[2,3]}" },
    "variables": {},
    "code": "test('equal ok', () => { expect(response.json()).toEqual({a:1,b:[2,3]}); }); test('equal bad', () => { expect(response.json()).toEqual({a:1,b:[2,4]}); });"
  },
  {
    "name": "toContain string and array",
    "mode": "validate",
    "response": { "status": 200, "statusText": "OK", "headers": {}, "time": 10, "bodyText": "{\"tags\":[\"a\",\"b\"]}" },
    "variables": {},
    "code": "test('str contains', () => { expect(response.text()).toContain('tags'); }); test('arr contains', () => { expect(response.json().tags).toContain('a'); }); test('arr missing', () => { expect(response.json().tags).toContain('z'); }); test('bad type', () => { expect(response.json()).toContain('x'); });"
  },
  {
    "name": "toMatch string-regex and RegExp",
    "mode": "validate",
    "response": { "status": 200, "statusText": "OK", "headers": {}, "time": 10, "bodyText": "hello-123" },
    "variables": {},
    "code": "test('match str', () => { expect(response.text()).toMatch('[0-9]+'); }); test('match re', () => { expect(response.text()).toMatch(/^hello/); }); test('match fail', () => { expect(response.text()).toMatch(/^world/); });"
  },
  {
    "name": "numeric comparisons",
    "mode": "validate",
    "response": { "status": 200, "statusText": "OK", "headers": {}, "time": 150, "bodyText": "" },
