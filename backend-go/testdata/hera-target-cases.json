{
  "comment": "Shared fixture for Hera target validation. `dns` stubs resolution so the harness needs no network. `selfPort` is the instance's own port. Rejection reason strings MUST be identical across both backends — a divergence means one backend is a bypass for the other.",
  "selfPort": "4000",
  "dns": {
    "api.example.com": ["93.184.216.34"],
    "staging.example.com": ["10.1.2.3"],
    "rebind.evil.com": ["93.184.216.34", "169.254.169.254"],
    "loopback.evil.com": ["127.0.0.1"],
    "ecs.evil.com": ["169.254.170.2"],
    "alibaba.evil.com": ["100.100.100.200"],
    "oracle.evil.com": ["192.0.0.192"],
    "v6.evil.com": ["fd00::1"],
    "linklocal6.evil.com": ["fe80::1"],
    "unspec.evil.com": ["0.0.0.0"],
    "multi.example.com": ["93.184.216.34", "93.184.216.35"],
    "localhost": ["127.0.0.1"],
    "app.internal": ["10.9.8.7"]
  },
  "cases": [
    { "name": "imds-aws-literal", "url": "http://169.254.169.254/latest/meta-data/iam/security-credentials/", "allow": [] },
    { "name": "imds-ecs-literal", "url": "http://169.254.170.2/v2/credentials", "allow": ["*"] },
    { "name": "imds-via-dns", "url": "http://ecs.evil.com/v2/credentials", "allow": ["ecs.evil.com"] },
    { "name": "imds-name-google", "url": "http://metadata.google.internal/computeMetadata/v1/", "allow": ["metadata.google.internal"] },
    { "name": "imds-name-bare", "url": "http://metadata/", "allow": ["metadata"] },
    { "name": "imds-alibaba", "url": "http://alibaba.evil.com/", "allow": ["alibaba.evil.com"] },
    { "name": "imds-oracle", "url": "http://oracle.evil.com/", "allow": ["oracle.evil.com"] },
    { "name": "dns-rebind-one-bad-address", "url": "http://rebind.evil.com/", "allow": ["rebind.evil.com"] },
    { "name": "ipv6-unique-local", "url": "http://v6.evil.com/", "allow": ["v6.evil.com"] },
    { "name": "ipv6-link-local-literal", "url": "http://[fe80::1]/", "allow": ["*"] },
    { "name": "ipv6-link-local-via-dns", "url": "http://linklocal6.evil.com/", "allow": ["linklocal6.evil.com"] },
    { "name": "unspecified-address", "url": "http://unspec.evil.com/", "allow": ["unspec.evil.com"] },
    { "name": "scheme-file", "url": "file:///etc/passwd", "allow": ["*"] },
    { "name": "scheme-gopher", "url": "gopher://x/", "allow": ["*"] },
    { "name": "not-a-url", "url": "definitely not a url", "allow": ["*"] },
    { "name": "templated-host-unresolved", "url": "http://{{TARGET_HOST}}/api/health", "allow": ["*"] },
    { "name": "self-origin-api-denied", "url": "http://localhost:4000/api/health", "allow": ["localhost:4000"] },
    { "name": "self-origin-users-denied", "url": "http://127.0.0.1:4000/api/users", "allow": ["*"] },
    { "name": "self-origin-mock-allowed", "url": "http://localhost:4000/mock/items", "allow": [] },
    { "name": "self-origin-mock-allowed-ip", "url": "http://127.0.0.1:4000/mock/job", "allow": [] },
    { "name": "default-deny-external", "url": "http://api.example.com/v1/orders", "allow": [] },
    { "name": "allow-exact-host", "url": "http://api.example.com/v1/orders", "allow": ["api.example.com"] },
    { "name": "allow-wrong-host", "url": "http://api.example.com/v1/orders", "allow": ["other.example.com"] },
    { "name": "allow-wildcard-suffix", "url": "https://staging.example.com/v1/orders", "allow": ["*.example.com"] },
    { "name": "allow-host-port-match", "url": "http://app.internal:8080/health", "allow": ["app.internal:8080"] },
    { "name": "allow-host-port-mismatch", "url": "http://app.internal:9090/health", "allow": ["app.internal:8080"] },
    { "name": "allow-cidr-match", "url": "http://app.internal/health", "allow": ["10.0.0.0/8"] },
    { "name": "allow-cidr-miss", "url": "http://api.example.com/v1", "allow": ["10.0.0.0/8"] },
    { "name": "resolve-failure", "url": "http://nxdomain.invalid/", "allow": ["nxdomain.invalid"] },
    { "name": "loopback-other-port-default-deny", "url": "http://localhost:3000/api", "allow": [] },
    { "name": "loopback-other-port-allowed", "url": "http://localhost:3000/api", "allow": ["localhost:3000"] },
    { "name": "multi-address-all-clean", "url": "https://multi.example.com/v1", "allow": ["multi.example.com"] },
    { "name": "https-default-port", "url": "https://api.example.com/v1", "allow": ["api.example.com:443"] },
    { "name": "interpolated-host-allowed", "url": "{{BASE}}/mock/items", "vars": { "BASE": "http://localhost:4000" }, "allow": [] }
  ]
}
